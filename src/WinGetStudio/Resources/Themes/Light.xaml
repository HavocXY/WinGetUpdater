<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:String x:Key="Theme.Name">Light</sys:String>

  <SolidColorBrush x:Key="Bg.Window"    Color="#F4F5F7" />
  <SolidColorBrush x:Key="Bg.Sidebar"   Color="#EAECF0" />
  <SolidColorBrush x:Key="Bg.Card"      Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.CardAlt"   Color="#F7F8FA" />
  <SolidColorBrush x:Key="Bg.Input"     Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.Console"   Color="#FBFBFC" />
  <SolidColorBrush x:Key="Bg.Hover"     Color="#E8EBEF" />
  <SolidColorBrush x:Key="Bg.Selected"  Color="#DCE7FA" />

  <SolidColorBrush x:Key="Border.Default" Color="#D5D9E0" />
  <SolidColorBrush x:Key="Border.Strong"  Color="#B6BDC7" />

  <SolidColorBrush x:Key="Fg.Primary"   Color="#1F2328" />
  <SolidColorBrush x:Key="Fg.Secondary" Color="#57606A" />
  <SolidColorBrush x:Key="Fg.Muted"     Color="#7A828C" />
  <SolidColorBrush x:Key="Fg.OnAccent"  Color="#FFFFFF" />
  <SolidColorBrush x:Key="Fg.Console"   Color="#24292F" />

  <SolidColorBrush x:Key="Accent"        Color="#0B62D6" />
  <SolidColorBrush x:Key="Accent.Hover"  Color="#2A7BE8" />
  <SolidColorBrush x:Key="Accent.Press"  Color="#0A55BA" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#E6EFFC" />

  <SolidColorBrush x:Key="State.Ok"    Color="#1A7F37" />
  <SolidColorBrush x:Key="State.Warn"  Color="#9A6700" />
  <SolidColorBrush x:Key="State.Error" Color="#CF222E" />
  <SolidColorBrush x:Key="State.Admin" Color="#9A6700" />

  <SolidColorBrush x:Key="Ok.Subtle"     Color="#E4F4E8" />
  <SolidColorBrush x:Key="Danger.Subtle" Color="#FBE9EA" />

</ResourceDictionary>
