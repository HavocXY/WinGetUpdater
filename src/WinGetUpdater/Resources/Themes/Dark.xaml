<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Warme Neutraltoene mit eigenem Akzent.

    Grundflaeche und Schrift bleiben warm gehalten (nahezu Schwarz, gebrochenes Weiss,
    dazu zwei Grautoene). Der Akzent ist bewusst ein eigener Ton - ein Blaugruen, das
    zu den warmen Neutralen den Gegenpol bildet und die Anwendung keiner fremden
    Marke zuordnet.

    Drei Festlegungen, alle nachgemessen:

    - Der Akzent hat je Design einen eigenen Wert. Ein einzelner mittlerer Ton kann
      nicht gleichzeitig auf hellem und auf dunklem Grund 4,5:1 erreichen; hier ist
      er deshalb hell, in Light.xaml dunkel.
    - Auf dem hellen Akzent steht dunkler Text (#141413 auf #3FA294: 6,0:1).
    - Der Akzent ist als Aktionsfarbe belegt und bedeutet nie einen Zustand. Erfolg,
      Warnung und Fehler haben eigene Farben - und zusaetzlich eigene Zeichen und
      Texte, damit die Bedeutung nie allein an der Farbe haengt.
  -->

  <sys:String x:Key="Theme.Name">Dark</sys:String>

  <SolidColorBrush x:Key="Bg.Window"    Color="#141413" />
  <SolidColorBrush x:Key="Bg.Sidebar"   Color="#0F0F0E" />
  <SolidColorBrush x:Key="Bg.Card"      Color="#1C1C1A" />
  <SolidColorBrush x:Key="Bg.CardAlt"   Color="#232320" />
  <SolidColorBrush x:Key="Bg.Input"     Color="#232320" />
  <SolidColorBrush x:Key="Bg.Console"   Color="#0B0B0A" />
  <SolidColorBrush x:Key="Bg.Hover"     Color="#2A2A26" />
  <SolidColorBrush x:Key="Bg.Selected"  Color="#1F332F" />

  <SolidColorBrush x:Key="Border.Default" Color="#2E2E2A" />
  <SolidColorBrush x:Key="Border.Strong"  Color="#45443E" />

  <SolidColorBrush x:Key="Fg.Primary"   Color="#FAF9F5" />
  <SolidColorBrush x:Key="Fg.Secondary" Color="#B0AEA5" />
  <SolidColorBrush x:Key="Fg.Muted"     Color="#8E8D85" />
  <SolidColorBrush x:Key="Fg.OnAccent"  Color="#141413" />
  <SolidColorBrush x:Key="Fg.Console"   Color="#E8E6DC" />

  <SolidColorBrush x:Key="Accent"        Color="#3FA294" />
  <SolidColorBrush x:Key="Accent.Hover"  Color="#57B5A7" />
  <SolidColorBrush x:Key="Accent.Press"  Color="#2E8B7D" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#172623" />

  <SolidColorBrush x:Key="State.Ok"    Color="#8FA871" />
  <SolidColorBrush x:Key="State.Warn"  Color="#C9973F" />
  <SolidColorBrush x:Key="State.Error" Color="#DC6759" />
  <SolidColorBrush x:Key="State.Admin" Color="#C9973F" />

  <SolidColorBrush x:Key="Ok.Subtle"     Color="#1B2116" />
  <SolidColorBrush x:Key="Danger.Subtle" Color="#2C1815" />

</ResourceDictionary>
