<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:String x:Key="Theme.Name">Dark</sys:String>

  <SolidColorBrush x:Key="Bg.Window"    Color="#14161A" />
  <SolidColorBrush x:Key="Bg.Sidebar"   Color="#0F1115" />
  <SolidColorBrush x:Key="Bg.Card"      Color="#1B1E24" />
  <SolidColorBrush x:Key="Bg.CardAlt"   Color="#20242B" />
  <SolidColorBrush x:Key="Bg.Input"     Color="#232830" />
  <SolidColorBrush x:Key="Bg.Console"   Color="#0B0D10" />
  <SolidColorBrush x:Key="Bg.Hover"     Color="#262B34" />
  <SolidColorBrush x:Key="Bg.Selected"  Color="#2A3444" />

  <SolidColorBrush x:Key="Border.Default" Color="#2C323C" />
  <SolidColorBrush x:Key="Border.Strong"  Color="#3A424F" />

  <SolidColorBrush x:Key="Fg.Primary"   Color="#E7EAEE" />
  <SolidColorBrush x:Key="Fg.Secondary" Color="#9BA3AF" />
  <SolidColorBrush x:Key="Fg.Muted"     Color="#6B7280" />
  <SolidColorBrush x:Key="Fg.OnAccent"  Color="#FFFFFF" />
  <SolidColorBrush x:Key="Fg.Console"   Color="#D6DBE1" />

  <SolidColorBrush x:Key="Accent"        Color="#4C8DFF" />
  <SolidColorBrush x:Key="Accent.Hover"  Color="#6BA0FF" />
  <SolidColorBrush x:Key="Accent.Press"  Color="#3B78E0" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#1E2A3D" />

  <SolidColorBrush x:Key="State.Ok"    Color="#3FB950" />
  <SolidColorBrush x:Key="State.Warn"  Color="#D29922" />
  <SolidColorBrush x:Key="State.Error" Color="#F85149" />
  <SolidColorBrush x:Key="State.Admin" Color="#E3B341" />

  <SolidColorBrush x:Key="Ok.Subtle"     Color="#12291A" />
  <SolidColorBrush x:Key="Danger.Subtle" Color="#2A1618" />

</ResourceDictionary>
