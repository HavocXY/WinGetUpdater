<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Helle Fassung. Die Schluessel sind deckungsgleich mit Dark.xaml; nur die Werte wechseln.

    Zwei Werte kehren sich gegenueber dem dunklen Design bewusst um:

    - Der Akzent ist hier dunkel (#1C6E62 statt #3FA294), weil ein heller Ton auf
      gebrochenem Weiss keine 4,5:1 erreicht.
    - Entsprechend traegt der Akzent hier helle Schrift, dort dunkle. Fg.OnAccent ist
      deshalb pro Design verschieden; beide Fassungen liegen bei 5,8:1 bzw. 6,0:1.
  -->

  <sys:String x:Key="Theme.Name">Light</sys:String>

  <SolidColorBrush x:Key="Bg.Window"    Color="#FAF9F5" />
  <SolidColorBrush x:Key="Bg.Sidebar"   Color="#F2F0E9" />
  <SolidColorBrush x:Key="Bg.Card"      Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.CardAlt"   Color="#F7F5EE" />
  <SolidColorBrush x:Key="Bg.Input"     Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.Console"   Color="#FDFCF8" />
  <SolidColorBrush x:Key="Bg.Hover"     Color="#ECEAE0" />
  <SolidColorBrush x:Key="Bg.Selected"  Color="#DCEBE7" />

  <SolidColorBrush x:Key="Border.Default" Color="#E8E6DC" />
  <SolidColorBrush x:Key="Border.Strong"  Color="#B0AEA5" />

  <SolidColorBrush x:Key="Fg.Primary"   Color="#141413" />
  <SolidColorBrush x:Key="Fg.Secondary" Color="#57564F" />

  <!--
    Bewusst etwas dunkler als der erste Anlauf (#71706A): auf der Sidebar (Fg.Muted
    auf Bg.Sidebar #F2F0E9) misst der helle Wert nur 4,36:1 - unter der 4,5:1-Schwelle.
    #66655F bringt exakt dieses Paar auf 5,13:1 und alle uebrigen Fg.Muted-Paare -
    die dunkelste moegliche Flaeche ist Bg.Selected #DCEBE7 - auf 4,76:1, also alles
    >= 4,5:1. Der warme Grauton bleibt erhalten; Dark.xaml ist unangetastet.
    -->
  <SolidColorBrush x:Key="Fg.Muted"     Color="#66655F" />
  <SolidColorBrush x:Key="Fg.OnAccent"  Color="#FAF9F5" />
  <SolidColorBrush x:Key="Fg.Console"   Color="#24231F" />

  <SolidColorBrush x:Key="Accent"        Color="#1C6E62" />
  <SolidColorBrush x:Key="Accent.Hover"  Color="#175C52" />
  <SolidColorBrush x:Key="Accent.Press"  Color="#124B43" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#EDF5F3" />

  <SolidColorBrush x:Key="State.Ok"    Color="#5F7148" />
  <SolidColorBrush x:Key="State.Warn"  Color="#8F661B" />
  <SolidColorBrush x:Key="State.Error" Color="#A6392E" />
  <SolidColorBrush x:Key="State.Admin" Color="#8F661B" />

  <SolidColorBrush x:Key="Ok.Subtle"     Color="#EAF0E2" />
  <SolidColorBrush x:Key="Danger.Subtle" Color="#FAEAE7" />

</ResourceDictionary>
