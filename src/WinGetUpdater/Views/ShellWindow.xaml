<Window x:Class="WinGetUpdater.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WinGetUpdater.Views"
        xmlns:svc="clr-namespace:WinGetUpdater.Services"
        Title="WinGetUpdater" Height="820" Width="1180" MinHeight="620" MinWidth="900"
        Background="{DynamicResource Bg.Window}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

  <Window.Resources>
    <v:BoolToVisibilityConverter x:Key="Vis" />
    <v:BoolToVisibilityConverter x:Key="VisNot" Invert="True" />
    <v:NotEmptyToVisibilityConverter x:Key="VisFull" />
    <v:SelectedCommandConverter x:Key="IsSelectedCommand" />
    <v:LocTextConverter x:Key="LocText" />
  </Window.Resources>

  <Grid Background="{DynamicResource Bg.Window}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== Kopfleiste ==================== -->
    <Border Grid.Row="0" Background="{DynamicResource Bg.Sidebar}"
            BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,11,26,11">
          <Border Width="27" Height="27" CornerRadius="7" Background="{DynamicResource Accent}">
            <TextBlock Text="W" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource Fg.OnAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="WinGetUpdater" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding WingetSummary}" FontSize="10.5"
                       ToolTip="{Binding WingetTooltip}"
                       Foreground="{DynamicResource Fg.Muted}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                    Visibility="{Binding WingetAvailable, Converter={StaticResource Vis}}">
          <RadioButton Style="{StaticResource Tab}" GroupName="Mode" Padding="4,8"
                       IsChecked="{Binding IsUpdatesMode, Mode=OneWay}"
                       Command="{Binding ShowUpdatesCommand}"
                       Content="{Binding [Shell.Updates], Source={x:Static svc:Localizer.Instance}}" />
          <RadioButton Style="{StaticResource Tab}" GroupName="Mode" Padding="4,8"
                       IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                       Command="{Binding ShowAdvancedCommand}"
                       ToolTip="{Binding [Shell.AllCommandsHint], Source={x:Static svc:Localizer.Instance}}"
                       Content="{Binding [Shell.AllCommands], Source={x:Static svc:Localizer.Instance}}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Padding="8,3" CornerRadius="4" Margin="0,0,10,0"
                  Background="{DynamicResource Accent.Subtle}"
                  ToolTip="{Binding [Shell.Elevated], Source={x:Static svc:Localizer.Instance}}"
                  Visibility="{Binding IsElevated, Converter={StaticResource Vis}}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Shield}"
                  Width="13" Height="13" Stroke="{DynamicResource State.Admin}" />
          </Border>

          <!-- Ohne Adminrechte gestartet: klickbarer Hinweis statt stiller Einschraenkung -
               ein Klick loest denselben Neustart-Versuch aus wie der Dialog beim Programmstart. -->
          <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0"
                  Command="{Binding RestartElevatedCommand}"
                  ToolTip="{Binding [Shell.NotElevatedHint], Source={x:Static svc:Localizer.Instance}}"
                  Visibility="{Binding IsElevated, Converter={StaticResource VisNot}}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.TriangleAlert}"
                    Width="13" Height="13" VerticalAlignment="Center"
                    Stroke="{DynamicResource State.Warn}" />
              <TextBlock Text="{Binding [Shell.NotElevated], Source={x:Static svc:Localizer.Instance}}"
                         Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                         Foreground="{DynamicResource State.Warn}" />
            </StackPanel>
          </Button>

          <!-- Fehleranzeige: immer sichtbar, damit niemand raten muss, ob etwas schieflief -->
          <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ToggleLogCommand}"
                  ToolTip="{Binding [Log.Title], Source={x:Static svc:Localizer.Instance}}">
            <StackPanel Orientation="Horizontal">
              <Path Width="13" Height="13" VerticalAlignment="Center"
                    Data="{StaticResource Icon.TriangleAlert}">
                <Path.Style>
                  <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                    <Setter Property="Stroke" Value="{DynamicResource Fg.Secondary}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Log.HasErrors}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource State.Error}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <TextBlock Text="{Binding Log.BadgeText}" Margin="5,0,0,0" VerticalAlignment="Center"
                         FontSize="12"
                         Visibility="{Binding Log.HasProblems, Converter={StaticResource Vis}}" />
            </StackPanel>
          </Button>

          <Button Style="{StaticResource Btn.Ghost}" Content="DE / EN"
                  Command="{Binding ToggleLanguageCommand}"
                  ToolTip="{Binding [Shell.Language], Source={x:Static svc:Localizer.Instance}}" />
          <Button Style="{StaticResource Btn.Ghost}"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip="{Binding [Shell.Theme], Source={x:Static svc:Localizer.Instance}}">
            <Grid>
              <!-- Zeigt das Ziel des Klicks, nicht den aktuellen Stand: dunkel -> Sonnensymbol
                   (wechselt nach hell), hell -> Mondsymbol (wechselt nach dunkel). -->
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Sun}"
                    Width="13" Height="13" Stroke="{DynamicResource Fg.Secondary}"
                    Visibility="{Binding IsDarkTheme, Converter={StaticResource Vis}}" />
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Moon}"
                    Width="13" Height="13" Stroke="{DynamicResource Fg.Secondary}"
                    Visibility="{Binding IsDarkTheme, Converter={StaticResource VisNot}}" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== Inhalt ==================== -->
    <Grid Grid.Row="1">

      <!-- Hauptansicht: Updates -->
      <v:UpdatePage DataContext="{Binding Updates}"
                    Visibility="{Binding DataContext.IsUpdatesMode,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource Vis}}" />

      <!-- Vollständige winget-Oberfläche -->
      <Grid Visibility="{Binding IsAdvancedMode, Converter={StaticResource Vis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="252" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Bg.Sidebar}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Margin="14,14,14,10"
                     Text="{Binding NavFilter, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding [Nav.Search], Source={x:Static svc:Localizer.Instance}}" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
              <StackPanel>
                <TextBlock Text="{Binding [Nav.NoResults], Source={x:Static svc:Localizer.Instance}}"
                           Margin="16,10" Style="{StaticResource Text.Caption}"
                           Visibility="{Binding NavigationEmpty, Converter={StaticResource Vis}}" />

                <ItemsControl ItemsSource="{Binding Navigation}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Commands}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button HorizontalContentAlignment="Stretch" Margin="8,1" Padding="10,7"
                                      BorderThickness="0" Cursor="Hand"
                                      Command="{Binding DataContext.SelectCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}">
                                <Button.Style>
                                  <!-- Setter mit DynamicResource statt eines vom Converter fertig
                                       aufgeloesten Brush: der bliebe nach einem Themenwechsel auf
                                       der alten Farbe stehen, bis Id/CurrentCommandId sich erneut
                                       aendern (siehe Converters.cs, SelectedCommandConverter). -->
                                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                          <MultiBinding Converter="{StaticResource IsSelectedCommand}">
                                            <Binding Path="Id" />
                                            <Binding Path="DataContext.CurrentCommandId"
                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                          </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{DynamicResource Bg.Selected}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Title, Converter={StaticResource LocText}}"
                                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                  <Path Grid.Column="1" Style="{StaticResource Icon}"
                                        Data="{StaticResource Icon.TriangleAlert}"
                                        Width="11" Height="11" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Stroke="{DynamicResource State.Warn}"
                                        Visibility="{Binding Danger, Converter={StaticResource Vis}}" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding CommandCountText}" Margin="16,10"
                       Style="{StaticResource Text.Caption}" />
          </Grid>
        </Border>

        <v:CommandPage x:Name="Page" Grid.Column="1" DataContext="{Binding Current}" />
      </Grid>

      <!-- winget fehlt: erklären statt scheitern -->
      <Border Padding="40" MaxWidth="560" VerticalAlignment="Center"
              Visibility="{Binding WingetAvailable, Converter={StaticResource VisNot}}">
        <StackPanel>
          <TextBlock Text="{Binding [Winget.NotFound], Source={x:Static svc:Localizer.Instance}}"
                     Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding [Winget.NotFoundHint], Source={x:Static svc:Localizer.Instance}}"
                     Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
          <Button Margin="0,20,0,0" HorizontalAlignment="Left" Command="{Binding ToggleLogCommand}"
                  Content="{Binding [Log.Open], Source={x:Static svc:Localizer.Instance}}" />
        </StackPanel>
      </Border>

      <!-- ==================== Fehlerprotokoll ==================== -->
      <Border HorizontalAlignment="Right" Width="470"
              Background="{DynamicResource Bg.Card}"
              BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1,0,0,0"
              Visibility="{Binding ShowLog, Converter={StaticResource Vis}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="18,16,18,12">
            <Grid>
              <TextBlock Text="{Binding [Log.Title], Source={x:Static svc:Localizer.Instance}}"
                         FontSize="16" FontWeight="SemiBold" />
              <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Ghost}"
                      Command="{Binding ToggleLogCommand}"
                      ToolTip="{Binding [Log.Close], Source={x:Static svc:Localizer.Instance}}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.X}"
                      Width="11" Height="11" Stroke="{DynamicResource Fg.Secondary}" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding [Log.Subtitle], Source={x:Static svc:Localizer.Instance}}"
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>

          <Grid Grid.Row="1">
            <TextBlock Text="{Binding [Log.Empty], Source={x:Static svc:Localizer.Instance}}"
                       Margin="18,4" Style="{StaticResource Text.Caption}"
                       Visibility="{Binding Log.Entries.Count, Converter={StaticResource VisFull},
                                    ConverterParameter=invert}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,8,0">
              <ItemsControl ItemsSource="{Binding Log.Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="11,9" CornerRadius="7"
                            Background="{DynamicResource Bg.CardAlt}">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource State.Error}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource State.Warn}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Level}" Value="Info">
                                    <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="8,0,0,0"
                                     Foreground="{DynamicResource Fg.Muted}" />
                          <TextBlock Text="{Binding Source}" FontSize="10" Margin="8,0,0,0"
                                     Foreground="{DynamicResource Fg.Muted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontSize="12.5" />
                        <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="120"
                                 Foreground="{DynamicResource Fg.Muted}"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                 Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,10"
                      HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenLogFileCommand}"
                    Content="{Binding [Log.OpenFile], Source={x:Static svc:Localizer.Instance}}" />
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding CopyLogCommand}"
                    Content="{Binding [Log.Copy], Source={x:Static svc:Localizer.Instance}}" />
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ClearLogCommand}"
                    Content="{Binding [Log.Clear], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
