<UserControl x:Class="WinGetUpdater.Views.CommandPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WinGetUpdater.Views"
             xmlns:svc="clr-namespace:WinGetUpdater.Services">

  <UserControl.Resources>
    <v:BoolToVisibilityConverter x:Key="Vis" />
    <v:BoolToVisibilityConverter x:Key="VisNot" Invert="True" />
    <v:NotEmptyToVisibilityConverter x:Key="VisFull" />
    <v:LineKindToBrushConverter x:Key="LineBrush" />
    <v:RunStateToBrushConverter x:Key="StateBrush" />
    <v:InverseBoolConverter x:Key="Not" />

    <!-- Eine Werteingabe: Beschriftung, Eingabefeld je nach Art, Leeren-Knopf. -->
    <DataTemplate x:Key="ValueOptionTemplate">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                    ToolTip="{Binding Description}">
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding CliHint}" FontFamily="{StaticResource Font.Mono}"
                     FontSize="10.5" Foreground="{DynamicResource Fg.Muted}" />
        </StackPanel>

        <!-- Auswahlliste -->
        <ComboBox Grid.Column="1" ItemsSource="{Binding EnumValues}"
                  SelectedItem="{Binding TextValue, Mode=TwoWay}"
                  ToolTip="{Binding Description}"
                  Visibility="{Binding IsEnum, Converter={StaticResource Vis}}" />

        <!-- Pfad mit Durchsuchen -->
        <Grid Grid.Column="1" Visibility="{Binding IsPath, Converter={StaticResource Vis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{Binding Description}" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,5"
                  Command="{Binding BrowseCommand}"
                  Content="{Binding [Options.Browse], Source={x:Static svc:Localizer.Instance}}" />
        </Grid>

        <!-- Freitext, ggf. wiederholbar -->
        <Grid Grid.Column="1" Visibility="{Binding IsPlainText, Converter={StaticResource Vis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding Placeholder}" ToolTip="{Binding Description}" />
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0"
                          Visibility="{Binding Items.Count, Converter={StaticResource VisFull}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Accent.Subtle}" CornerRadius="10"
                          Padding="9,3" Margin="0,0,5,4">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding}" FontSize="11.5" />
                      <Button Content="✕" Margin="6,0,0,0" Padding="0" FontSize="10"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource Fg.Secondary}"
                              Command="{Binding DataContext.RemoveItemCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,5" VerticalAlignment="Top"
                  Command="{Binding AddItemCommand}"
                  Visibility="{Binding IsRepeatable, Converter={StaticResource Vis}}"
                  Content="{Binding [Options.Add], Source={x:Static svc:Localizer.Instance}}" />
        </Grid>

        <Button Grid.Column="2" Margin="6,0,0,0" Content="✕" Padding="8,5"
                Style="{StaticResource Btn.Ghost}"
                Command="{Binding ClearCommand}"
                Visibility="{Binding IsSet, Converter={StaticResource Vis}}" />
      </Grid>
    </DataTemplate>

    <!-- Ein Schalter als Kachel. -->
    <DataTemplate x:Key="FlagOptionTemplate">
      <Border Margin="0,0,8,8" Padding="10,7" CornerRadius="5"
              Background="{DynamicResource Bg.CardAlt}"
              BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
              ToolTip="{Binding Description}">
        <StackPanel Orientation="Horizontal">
          <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Content="{Binding Label}" />
          <TextBlock Text="⚠" Margin="6,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource State.Warn}"
                     Visibility="{Binding IsRisky, Converter={StaticResource Vis}}"
                     ToolTip="{Binding [Options.Risky], Source={x:Static svc:Localizer.Instance}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="22,18,22,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ Kopf ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
          <Border Margin="10,2,0,0" Padding="7,2" CornerRadius="3" VerticalAlignment="Center"
                  Background="{DynamicResource Bg.CardAlt}" BorderThickness="1"
                  BorderBrush="{DynamicResource Border.Default}">
            <TextBlock Text="{Binding CommandPath}" FontFamily="{StaticResource Font.Mono}"
                       FontSize="11" Foreground="{DynamicResource Fg.Secondary}" />
          </Border>
          <Border Margin="8,2,0,0" Padding="7,2" CornerRadius="3" VerticalAlignment="Center"
                  Background="{DynamicResource Accent.Subtle}"
                  Visibility="{Binding IsDangerous, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding [Header.Danger], Source={x:Static svc:Localizer.Instance}}"
                       FontSize="11" Foreground="{DynamicResource State.Warn}" />
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                   Margin="0,5,20,0" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ResetCommand}"
                Content="{Binding [Options.Reset], Source={x:Static svc:Localizer.Instance}}" />
        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenDocsCommand}"
                Content="{Binding [Header.Docs], Source={x:Static svc:Localizer.Instance}}" />
      </StackPanel>
    </Grid>

    <!-- ============ Optionen ============ -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
      <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="{Binding [Options.None], Source={x:Static svc:Localizer.Instance}}"
                     Style="{StaticResource Text.Caption}"
                     Visibility="{Binding HasAnyOption, Converter={StaticResource VisNot}}" />

          <TextBlock Text="{Binding [Options.Primary], Source={x:Static svc:Localizer.Instance}}"
                     Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,8"
                     Visibility="{Binding HasAnyOption, Converter={StaticResource Vis}}" />
          <ItemsControl ItemsSource="{Binding PrimaryValues}" ItemTemplate="{StaticResource ValueOptionTemplate}" />
          <ItemsControl ItemsSource="{Binding PrimaryFlags}" ItemTemplate="{StaticResource FlagOptionTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>

          <Expander Margin="0,10,0,0" Foreground="{DynamicResource Fg.Secondary}"
                    Visibility="{Binding HasAdvanced, Converter={StaticResource Vis}}">
            <Expander.Header>
              <TextBlock Text="{Binding AdvancedHeader}" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource Fg.Secondary}" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding AdvancedValues}" ItemTemplate="{StaticResource ValueOptionTemplate}" />
              <ItemsControl ItemsSource="{Binding AdvancedFlags}" ItemTemplate="{StaticResource FlagOptionTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <Expander Margin="0,6,0,0">
            <Expander.Header>
              <TextBlock Text="{Binding GlobalHeader}" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource Fg.Secondary}" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding GlobalValues}" ItemTemplate="{StaticResource ValueOptionTemplate}" />
              <ItemsControl ItemsSource="{Binding GlobalFlags}" ItemTemplate="{StaticResource FlagOptionTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>

              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{Binding [Options.Extra], Source={x:Static svc:Localizer.Instance}}" />
                  <TextBlock Text="{Binding [Options.ExtraHint], Source={x:Static svc:Localizer.Instance}}"
                             FontSize="10.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource Fg.Muted}" />
                </StackPanel>
                <TextBox Grid.Column="1" VerticalAlignment="Top"
                         FontFamily="{StaticResource Font.Mono}"
                         Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ============ Vorschau und Start ============ -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="{Binding [Preview.Title], Source={x:Static svc:Localizer.Instance}}"
                     FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Muted}"
                     Margin="0,0,0,5" />
          <Border Background="{DynamicResource Bg.Console}" CornerRadius="4" Padding="10,8">
            <TextBox Text="{Binding PreviewLine, Mode=OneWay}" IsReadOnly="True"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     TextWrapping="Wrap" Foreground="{DynamicResource Fg.Console}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding CopyCommand}"
                    Content="{Binding [Preview.Copy], Source={x:Static svc:Localizer.Instance}}" />
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding SaveScriptCommand}"
                    Content="{Binding [Preview.Save], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource Vis}}"
                    Content="{Binding [Run.Cancel], Source={x:Static svc:Localizer.Instance}}" />
            <Button Style="{StaticResource Btn.Primary}" Command="{Binding RunCommand}"
                    Padding="26,7" Content="{Binding [Run.Execute], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox IsChecked="{Binding Elevated, Mode=TwoWay}" IsEnabled="{Binding CanElevate}"
                    Content="{Binding [Run.Elevated], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Text="{Binding ElevationNote}" Margin="12,0,0,0" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{DynamicResource State.Admin}"
                     Visibility="{Binding ShowElevationNote, Converter={StaticResource Vis}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Ergebnis ============ -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="14,8,12,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Tab}" GroupName="ResultView"
                         Command="{Binding ShowTableViewCommand}"
                         IsChecked="{Binding OutputView, Mode=OneWay, Converter={StaticResource Not}}"
                         Visibility="{Binding CanShowTable, Converter={StaticResource Vis}}"
                         Content="{Binding [Result.Table], Source={x:Static svc:Localizer.Instance}}" />
            <RadioButton Style="{StaticResource Tab}" GroupName="ResultView"
                         Command="{Binding ShowOutputViewCommand}"
                         IsChecked="{Binding OutputView, Mode=OneWay}"
                         Content="{Binding [Result.Output], Source={x:Static svc:Localizer.Instance}}" />
            <TextBlock Text="{Binding RowCountText}" VerticalAlignment="Center" Margin="4,0,0,0"
                       Style="{StaticResource Text.Caption}"
                       Visibility="{Binding ShowTable, Converter={StaticResource Vis}}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Visibility="{Binding ShowTable, Converter={StaticResource Vis}}">
            <TextBox Width="190" Margin="0,0,10,0"
                     Tag="{Binding [Result.Filter], Source={x:Static svc:Localizer.Instance}}"
                     Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="ActionInstall" Style="{StaticResource Btn.Ghost}" Tag="install"
                    Click="OnPackageAction"
                    Content="{Binding [Grid.Install], Source={x:Static svc:Localizer.Instance}}" />
            <Button x:Name="ActionUpgrade" Style="{StaticResource Btn.Ghost}" Tag="upgrade"
                    Click="OnPackageAction"
                    Content="{Binding [Grid.Upgrade], Source={x:Static svc:Localizer.Instance}}" />
            <Button x:Name="ActionUninstall" Style="{StaticResource Btn.Ghost}" Tag="uninstall"
                    Click="OnPackageAction"
                    Content="{Binding [Grid.Uninstall], Source={x:Static svc:Localizer.Instance}}" />
            <Button x:Name="ActionShow" Style="{StaticResource Btn.Ghost}" Tag="show"
                    Click="OnPackageAction"
                    Content="{Binding [Grid.Details], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
        </Grid>

        <!-- Ergebnisgitter -->
        <DataGrid x:Name="ResultGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  ItemsSource="{Binding Rows}" SelectionMode="Extended"
                  SelectionChanged="OnGridSelectionChanged"
                  Visibility="{Binding OutputView, Converter={StaticResource VisNot}}" />

        <!-- Rohausgabe -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Console}"
                Visibility="{Binding OutputView, Converter={StaticResource Vis}}">
          <Grid>
            <TextBlock Text="{Binding [Result.Empty], Source={x:Static svc:Localizer.Instance}}"
                       Margin="14" Foreground="{DynamicResource Fg.Muted}"
                       Visibility="{Binding Output.Count, Converter={StaticResource VisFull},
                                    ConverterParameter=invert}" />
            <ScrollViewer x:Name="OutputScroll" Padding="12,10" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Output}" VirtualizingPanel.IsVirtualizing="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Font.Mono}"
                               FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{Binding Kind, Converter={StaticResource LineBrush}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ============ Statuszeile ============ -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,0,0,10">
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
               Fill="{Binding State, Converter={StaticResource StateBrush}}" />
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" />
    </StackPanel>
  </Grid>
</UserControl>
